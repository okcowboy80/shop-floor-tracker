<Window x:Class="InventoryTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Tracker" Height="600" Width="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Click="Save_Click"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Items">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ItemsGrid" Grid.Row="0"
                              AutoGenerateColumns="False" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part #" Binding="{Binding PartNumber}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Reorder At" Binding="{Binding ReorderLevel}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Margin="0,10,0,5" FontWeight="SemiBold"
                               Text="Stock by location for the selected item:"/>

                    <DataGrid x:Name="StockGrid" Grid.Row="2"
                              AutoGenerateColumns="False" CanUserAddRows="True"
                              ItemsSource="{Binding SelectedItem.StockLevels, ElementName=ItemsGrid}">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn x:Name="LocationColumn" Header="Location" Width="*"
                                                    DisplayMemberPath="Name"
                                                    SelectedValuePath="Id"
                                                    SelectedValueBinding="{Binding LocationId}"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Locations">
                <DataGrid x:Name="LocationsGrid" Margin="5"
                          AutoGenerateColumns="False" CanUserAddRows="True"
                          PreviewKeyDown="LocationsGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Location" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>